# OAuth client ID from your own Google Cloud project.
# Google Auth Platform -> Clients -> Create client -> "Chrome Extension".
# Chrome Extension clients use no client secret. Never add one here.
# The client ID is not a secret, but it is bound to this build's extension ID.
# See README.md section "Google Cloud setup".
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
